  "keyFeatures": [
    "Lightweight (~40 KB minzipped) financial chart library built on HTML5 canvas",
    "Six built-in series types: Line, Area, Bar, Candlestick, Baseline, Histogram",
    "Three chart types: standard time-based, yield curve, and options (price-based)",
    "Multi-pane layouts with resizable panes",
    "Left, right, and overlay price scales with multiple modes",
    "Interactive time scale with logical range, zooming, and scrolling",
    "Plugin system supporting custom series, series primitives, and pane primitives",
    "Built-in plugins: text/image watermarks, series markers, up/down markers",
    "TypeScript-first with full type declarations",
    "Framework-agnostic with guides for React, Vue, and Web Components",
    "ES module and standalone (IIFE) build variants",
    "AI coding assistant support via Agent Skill and llms.txt"
  ],
  "publicApiSurface": [
    "createChart(container, options)",
    "createYieldCurveChart(container, options)",
    "createOptionsChart(container, options)",
    "createChartEx(container, paneView, horzScaleBehavior, options)",
    "IChartApi.addSeries(definition, options, paneIndex)",
    "IChartApi.addCustomSeries(customPaneView, options, paneIndex)",
    "IChartApi.removeSeries(seriesApi)",
    "IChartApi.timeScale()",
    "IChartApi.priceScale(priceScaleId)",
    "IChartApi.applyOptions(options)",
    "IChartApi.subscribeClick(handler)",
    "IChartApi.subscribeCrosshairMove(handler)",
    "IChartApi.takeScreenshot()",
    "ISeriesApi.setData(data)",
    "ISeriesApi.update(bar)",
    "ISeriesApi.applyOptions(options)",
    "ISeriesApi.priceScale()",
    "ISeriesApi.attachPrimitive(primitive)",
    "ITimeScaleApi.setVisibleRange(range)",
    "ITimeScaleApi.setVisibleLogicalRange(range)",
    "ITimeScaleApi.fitContent()",
    "IPriceScaleApi.applyOptions(options)",
    "IPaneApi.attachPrimitive(primitive)",
    "LineSeries, AreaSeries, BarSeries, CandlestickSeries, BaselineSeries, HistogramSeries",
    "createTextWatermark(pane, options)",
    "createImageWatermark(pane, options)",
    "createSeriesMarkers(series, markers)",
    "createUpDownMarkers(series, options)",
    "version()"
  ]
